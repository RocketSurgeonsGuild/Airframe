<Project>
  <!-- Imported only by explicit Cleanup/VerifyCleanup formatter processes. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)../src/Analyzers/bin/$(Configuration)/netstandard2.0/Rocket.Surgery.Airframe.Analyzers.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)../src/CodeFixes/bin/$(Configuration)/netstandard2.0/Rocket.Surgery.Airframe.CodeFixes.dll" />
  </ItemGroup>
</Project>
