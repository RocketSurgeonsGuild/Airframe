<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>A set of analyzers and code fixes for common patterns found in Airframe based applications.</Description>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <PackageId>Rocket.Surgery.Airframe.CodeAnalysis</PackageId>
        <Version>1.0.0.9</Version>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <GeneratedFolder>Generated</GeneratedFolder>
        <NoWarn>RS1022</NoWarn>
        <NoPackageAnalysis>true</NoPackageAnalysis>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssemblies</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!--
      The CI pipeline packs with NoBuild after a separate build step. Resolving
      references would otherwise invoke the Build target on the referenced projects,
      which NoBuild forbids (NETSDK1085). Asking for their target paths instead
      reuses the assemblies the earlier build already produced.
    -->
    <PropertyGroup Condition="'$(NoBuild)' == 'true'">
        <BuildProjectReferences>false</BuildProjectReferences>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <ProjectReference Include="..\Analyzers\Analyzers.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\CodeFixes\CodeFixes.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!--
      Packs the analyzer and code fix assemblies produced by the referenced projects.
      Paths are resolved from the build rather than hardcoded so the package always
      picks up the assemblies for the configuration currently being built.
    -->
    <Target Name="PackAnalyzerAssemblies" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_AnalyzerAssembly Include="@(ReferencePath->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
            <_AnalyzerSymbol Include="@(_AnalyzerAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
            <TfmSpecificPackageFile Include="@(_AnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
            <TfmSpecificPackageFile Include="@(_AnalyzerSymbol)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
        <Error Condition="'@(_AnalyzerAssembly)' == ''"
               Text="No analyzer assemblies were resolved from project references; the package would ship empty." />
    </Target>
</Project>
